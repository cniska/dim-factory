#!/usr/bin/env bash
# wt — one task, one worktree.
#
# Convention: task worktrees live at <repo>/.claude/worktrees/<branch>, the same
# path Claude Code's EnterWorktree and a manual `git worktree add` use. wt makes
# the checkout and prints where it is; opening a terminal there and starting an
# agent is the caller's job.
#
# On fresh creation, wt runs an optional repo hook — scripts/worktree-setup.sh —
# so a new worktree arrives with dependencies installed. The hook is opt-in per
# repo (skipped if absent) and non-fatal (a failed install still leaves a usable
# worktree). Reusing an existing worktree skips the hook.
#
# On removal it runs the matching scripts/worktree-teardown.sh first, so a repo
# whose worktrees own outside resources can release them while the worktree is
# still there to describe them.
set -euo pipefail

die() { printf 'wt: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
wt — parallel-task worktrees, one per agent.

Usage:
  wt <branch>      create (or reuse) a worktree and print its path
  wt ls            list this repo's task worktrees
  wt path <branch> print the worktree path (for `cd "$(wt path x)"`)
  wt rm [--force] <branch>
                    remove the worktree
  wt prune         prune stale worktree admin entries

Worktrees live at <repo>/.claude/worktrees/<branch>. On creation, wt runs the
repo's scripts/worktree-setup.sh if present (dependency install, etc.); on
removal it runs scripts/worktree-teardown.sh first, and keeps the worktree if
that fails unless --force.
EOF
}

# Main working tree, even when invoked from inside a worktree. --git-common-dir
# resolves to the shared .git; its parent is the primary checkout.
repo_root() {
    local common
    common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
        || die "not inside a git repository"
    dirname "$common"
}

# Run the repo's worktree bootstrap so a fresh checkout is ready for the agent.
# Opt-in (only if the tracked hook exists) and non-fatal (a failed install still
# leaves a worktree to debug in), so wt stays generic across repos.
run_bootstrap() {
    local path=$1 hook="$path/scripts/worktree-setup.sh"
    [ -x "$hook" ] || return 0
    echo "wt: bootstrapping worktree via scripts/worktree-setup.sh"
    local rc=0
    ( cd "$path" && "$hook" ) || rc=$?
    if [ "$rc" -eq 0 ]; then
        echo "wt: bootstrap complete"
    else
        echo "wt: bootstrap failed (exit $rc) — worktree created; fix and re-run the hook" >&2
    fi
}

# Run the repo's teardown while the worktree is still there — its inputs live
# inside it, so anything the hook owns (containers, volumes, a reserved port
# block) becomes unattributable the moment the directory goes. Opt-in like the
# bootstrap hook, but fatal where that one is not: a failed bootstrap leaves a
# worktree to debug, while removing after a failed teardown strands the
# resources with nothing left naming them. --force is the deliberate override.
run_teardown() {
    local path=$1 force=$2 hook="$path/scripts/worktree-teardown.sh"
    [ -x "$hook" ] || return 0
    echo "wt: tearing down worktree via scripts/worktree-teardown.sh"
    local rc=0
    ( cd "$path" && "$hook" ) || rc=$?
    [ "$rc" -eq 0 ] && return 0
    [ "$force" = true ] \
        || die "teardown failed (exit $rc) — worktree kept; fix it, or re-run with --force"
    echo "wt: teardown failed (exit $rc) — removing anyway (--force)" >&2
}

cmd_open() {
    local branch=$1
    [ -n "$branch" ] || die "branch name required"
    local root path created=false
    root=$(repo_root)
    path="$root/.claude/worktrees/$branch"

    if [ -d "$path" ]; then
        echo "wt: reusing existing worktree $path"
    elif git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
        git -C "$root" worktree add "$path" "$branch"
        created=true
    else
        git -C "$root" worktree add "$path" -b "$branch"
        created=true
    fi

    [ "$created" = true ] && run_bootstrap "$path"

    echo "wt: worktree ready at:"
    echo "    $path"
}

cmd_ls() {
    local root path
    root=$(repo_root)
    path="$root/.claude/worktrees"
    [ -d "$path" ] || { echo "wt: no task worktrees"; return; }
    git -C "$root" worktree list --porcelain \
        | awk -v p="$path/" '
            /^worktree / { wt = substr($0, 10) }
            /^branch /   { br = substr($0, 8); sub("refs/heads/", "", br)
                           if (index(wt, p) == 1) printf "  %-24s %s\n", br, wt }'
}

cmd_path() {
    local branch=$1
    [ -n "$branch" ] || die "branch name required"
    echo "$(repo_root)/.claude/worktrees/$branch"
}

cmd_rm() {
    local force=false branch=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --force | -f) force=true ;;
            --) shift; branch=${1:-}; break ;;
            -*) die "unknown rm option: $1" ;;
            *)
                [ -z "$branch" ] || die "branch name specified more than once"
                branch=$1
                ;;
        esac
        shift
    done
    [ -n "$branch" ] || die "branch name required"
    local root path
    root=$(repo_root)
    path="$root/.claude/worktrees/$branch"
    [ -d "$path" ] || die "no worktree at $path"
    run_teardown "$path" "$force"
    if [ "$force" = true ]; then
        git -C "$root" worktree remove --force "$path"
    else
        git -C "$root" worktree remove "$path"
    fi
    echo "wt: removed worktree $path"
    echo "wt: branch '$branch' kept — delete with 'git -C $root branch -d $branch' once merged"
}

cmd_prune() {
    git -C "$(repo_root)" worktree prune
    echo "wt: pruned stale worktree entries"
}

case "${1:-}" in
    "" | -h | --help | help) usage ;;
    ls)                       cmd_ls ;;
    path)                     shift; cmd_path "${1:-}" ;;
    rm)                       shift; cmd_rm "$@" ;;
    prune)                    cmd_prune ;;
    *)                        cmd_open "$1" ;;
esac
