{
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "artifact", "answers", "tests"],
  "properties": {
    "subject": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
    "artifact": { "type": "string" },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding", "answer", "resolution"],
        "properties": {
          "finding": { "type": "integer" },
          "answer": { "type": "string", "enum": ["fixed", "refused"] },
          "resolution": { "type": ["string", "null"] }
        }
      }
    },
    "tests": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
