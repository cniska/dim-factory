{
  "name": "dim-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dim": "./src/cli.ts"
  },
  "scripts": {
    "dim": "bun run src/cli.ts",
    "fetch-model": "bun run scripts/fetch-model.ts",
    "factory:reset": "bun run scripts/reset-factory.ts",
    "format": "bunx biome format --write src",
    "lint": "bunx biome check --error-on-warnings src",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "verify": "bun run lint && bun run typecheck && bun test && bun run test:wt",
    "test:wt": "WT_CMD=\"bun run $PWD/src/cli.ts wt\" ./scripts/wt.test.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@huggingface/transformers": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
