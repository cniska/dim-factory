{
  "name": "dim-factory",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "dim": "./src/cli.ts"
  },
  "scripts": {
    "dim": "bun run src/cli.ts",
    "prepare": "git config core.hooksPath .githooks",
    "format": "bunx biome check --write src acceptance",
    "lint": "bunx biome check --error-on-warnings src acceptance",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:acceptance": "bun test --parallel --concurrent --max-concurrency=3 ./acceptance/*.acceptance.ts",
    "verify": "bun run lint && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@babel/types": "^7.29.8",
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  }
}
