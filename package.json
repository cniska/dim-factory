{
  "name": "dim-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dim": "./src/cli.ts"
  },
  "scripts": {
    "dim": "bun run src/cli.ts",
    "fetch-model": "bun run scripts/fetch-model.ts",
    "format": "bunx biome format --write src",
    "lint": "bunx biome check --error-on-warnings src",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "verify": "bun run lint && bun run typecheck && bun test && bun run test:wt",
    "test:wt": "WT_CMD=\"bun run $PWD/src/cli.ts wt\" ./scripts/wt.test.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "jsonc-parser": "^3.3.1"
  }
}
